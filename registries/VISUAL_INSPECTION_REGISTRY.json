{
  "schema_version": 1,
  "id": "videobatch-fast-visual-inspection",
  "version": "2.8.3-rc24",
  "title": "provoware - videoautomation - 2026 · visuelle Prüfoberfläche",
  "html_output": "visual_inspection/index.html",
  "manifest_output": "VISUAL_INSPECTION_MANIFEST.json",
  "visual_registry": "registries/VISUAL_REGRESSION_REGISTRY.json",
  "visual_report": "diagnostics/visual_regression_latest.json",
  "baseline_directory": "tests/baselines",
  "actual_directory": "tests/visual_actual",
  "difference_directory": "diagnostics/visual_diff",
  "rules": {
    "offline_first": true,
    "manifest_embedded_in_html": true,
    "manifest_link_visible": true,
    "baseline_replacement_requires_explicit_acceptance": true,
    "failed_scenario_requires_difference_image": true,
    "groups": [
      "dashboard",
      "workspace",
      "dialogs"
    ],
    "manual_desktop_approval_signature": true,
    "approval_invalidates_on_visual_change": true,
    "manual_approval_must_name_reviewer": true,
    "stable_release_requires_valid_manual_approval": true
  }
}
